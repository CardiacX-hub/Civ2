{
  "name": "ashfang-rts",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "build:graphics": "esbuild graphics/modern-renderer.js --bundle --format=esm --minify --outfile=graphics/modern-renderer.bundle.js && esbuild graphics/live-battlefield.js --bundle --format=esm --minify --outfile=graphics/live-battlefield.bundle.js",
    "build:exporter": "esbuild tools/live-export-entry.js --bundle --format=iife --outfile=/tmp/kaw-exporter.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "three": "^0.180.0"
  }
}
